#!/usr/bin/env bash
# Launch Obsidian for obsidian.service. Headless (CLI) is the default mode:
#   - default                 -> Chromium ozone headless, no X needed
#   - OBSIDIAN_FORCE_GUI=1    -> normal window, if a usable graphical session exists
# The Local REST API plugin (127.0.0.1:27123/27124) works identically in both,
# so the obsidian MCP server never notices the difference.
#
# 2026-09-28 反转默认（原先是"有图形会话就开窗口"）。理由：
#   1. 这个服务只为 MCP 提供 REST API，窗口没有人看。
#   2. 窗口模式把 GPU/合成器拉进依赖链，纯属多出来的故障面
#      （本机实测会打 "vaInitialize failed: unknown libva error"）。
#   3. 宿主切到 CLI 模式（systemctl isolate multi-user.target）时，
#      图形会话消失，窗口模式会在重启后换模式；headless 不受影响。
#   4. 确定性：每次启动同一种模式，行为不再取决于启动时机是否恰好有图形会话。
# 需要窗口时：OBSIDIAN_FORCE_GUI=1（或在 service 里 Environment= 设置）。
set -u
APP="${OBSIDIAN_APPIMAGE:-$HOME/Applications/Obsidian.AppImage}"
# --no-sandbox: Ubuntu's apparmor_restrict_unprivileged_userns=1 makes the
# Chromium SUID sandbox abort when the AppImage is started outside the desktop.
# --js-flags: Omnisearch keeps its BM25 index in the renderer V8 heap. With this
# vault (150+ MB of indexed markdown) two concurrent MCP search agents, each
# pulling multi-MB responses, exhausted the default heap and killed the renderer
# while systemd still saw the main process alive.
#
# 2026-09-22 记录:12288 MB 仍然不够 —— 渲染进程触发了全局 OOM
#   kernel: V8Worker invoked oom-killer ... global_oom
#   systemd: obsidian.service: Failed with result 'oom-kill'
# 每次 OOM 后 Restart=always 重启,而 Omnisearch 的 51361 端口比 27123 晚就绪,
# 于是调用方在那个窗口里拿到 ERROR —— 表现为"时不时 error、时不时 OK"。
# 本机 251 GB 物理内存、常态可用 230 GB 以上,故放宽到 32 GB。
# 注意 obsidian.service 带 OOMScoreAdjust=200:真到内存紧张时内核会优先杀
# Obsidian 而不是实验进程,这是有意的取舍(Obsidian 可自动重启,实验不可)。
COMMON=(--no-sandbox --js-flags="--max-old-space-size=32768")

gui_available() {
  # Headless is the default; a window requires an explicit opt-in.
  [ "${OBSIDIAN_FORCE_GUI:-0}" = "1" ] || return 1
  [ "${OBSIDIAN_FORCE_HEADLESS:-0}" = "1" ] && return 1
  systemctl --user -q is-active graphical-session.target || return 1
  if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY}" ]; then
    return 0
  fi
  if [ -n "${DISPLAY:-}" ] && [ -S "/tmp/.X11-unix/X${DISPLAY#:}" ]; then
    return 0
  fi
  return 1
}

if gui_available; then
  echo "obsidian-managed: OBSIDIAN_FORCE_GUI=1 且图形会话可用，开窗口启动 (DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-})"
  exec "$APP" "${COMMON[@]}"
else
  echo "obsidian-managed: 按默认以 headless (CLI) 模式启动"
  # Scrub the desktop-session environment, not just the display variables.
  #
  # 2026-09-28: 只 unset DISPLAY/WAYLAND_DISPLAY/XAUTHORITY 是不够的。桌面会话会通过
  # `systemctl --user import-environment` 把 GNOME 会话变量注入 user manager，于是
  # 由 systemd 启动的 Obsidian 环境里仍写着「你在 GNOME 会话里」，Electron 便去做桌面/
  # 会话集成 —— 其中 SESSION_MANAGER 是 X11 XSMP 会话管理器地址，它会尝试连接，而
  # DISPLAY 已被 unset，于是主进程卡在 do_poll、renderer 永不生成、27123 永不监听、
  # 整个生命周期只烧 3s CPU。同一个脚本从交互 shell 跑却 10s 就绪，因为 shell 里
  # 没有这些变量 —— 这正是 systemd 启动与手动启动的唯一实质差异。
  unset DISPLAY WAYLAND_DISPLAY XAUTHORITY \
        SESSION_MANAGER \
        XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP DESKTOP_SESSION GDMSESSION \
        GNOME_DESKTOP_SESSION_ID GNOME_SHELL_SESSION_MODE GNOME_SETUP_DISPLAY \
        GTK_MODULES QT_ACCESSIBILITY IM_CONFIG_PHASE
  exec "$APP" "${COMMON[@]}" --ozone-platform=headless --disable-gpu
fi
