[Unit]
Description=mihomo (headless clash core)
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=simple
# 第一步永远是确认链路能联网 —— 代理必须排在"能上网"之后。
# 未认证时它会应用认证页直连加固并记录状态。
# 它从不阻断启动(阻断会彻底断网,比没有代理更糟)。
ExecStartPre=/etc/mihomo/ensure-campus-net.sh
ExecStartPre=/etc/mihomo/ensure-config.sh
# 2) mihomo 本体(TUN + 全局路由拦截 + 分流)
ExecStart=/usr/bin/verge-mihomo -d /etc/mihomo -f /etc/mihomo/config.yaml
# 3) mihomo 就绪后恢复远程访问
ExecStartPost=/etc/mihomo/ensure-beyond-underlay.sh
ExecStartPost=/etc/mihomo/ensure-remote-access.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=240
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
